@using GoogleBookApi.Controllers
@using GoogleBookApi.Helper

@{
    var homeController = WebHelper.GetControllerName<HomeController>();
    #region SEO
    var title = ViewData["Title"] is not null
        ? $"{ViewData["Title"]} | Google Books 圖書查詢"
        : "Google Books 圖書查詢";
    var description = ViewData["Description"] ?? "使用 Google Books API 搜尋圖書，支援 ISBN 及書名查詢，快束取得書籍詳細資料。";
    var ogDescription = ViewData["Description"] ?? "使用 Google Books API 搜尋圖書";
    var url = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var image = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/image/og/google-books-api-og-img.png")}";
    #endregion
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* SEO Preload Banner *@
    @await RenderSectionAsync("Preload", false)
    
    <meta name="description" content="@description"/>
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@ogDescription" />
    <meta property="og:url" content="@url"/>
    <meta property="og:image" content="@image"/>
    <meta name="apple-mobile-web-app-title" content="GoogleBooks"/>
    <link rel="canonical" href="@url"/>
    <title>@title</title>
    <link rel="icon" type="image/png" href="~/favicon-96x96.png" sizes="96x96"/>
    <link rel="shortcut" href="~/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg"/>
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GoogleBookApi.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/css/sweetalert2.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Headers", false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bolder" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book"></i>
                    GoogleBooksApi
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center text-start">
                        <li class="nav-item d-flex align-items-center">
                            <i class="bi bi-house me-2 d-inline-block d-sm-none"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="@homeController" asp-action="@nameof(HomeController.Index)">
                                首頁
                            </a>
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <i class="bi bi-info-circle d-inline-block d-sm-none me-2"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="@homeController" asp-action="@nameof(HomeController.Guideline)">
                                使用說明
                            </a>
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <i class="bi bi-search d-inline-block d-sm-none me-2"></i>
                            <a class="nav-link text-dark" asp-area="" asp-controller="@homeController" asp-action="@nameof(HomeController.BookSearch)">
                                書籍搜尋
                            </a>
                        </li>
                        <li class="nav-link">
                            @* <i class="bi bi-git"></i> *@
                            <a class="nav-link text-dark" asp-area="" asp-controller="@homeController" asp-action="@nameof(HomeController.Version)">
                                版本紀錄
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <partial name="_Loader" />
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted position-fixed bottom-0 bg-light-subtle">
        <div class="container">
            <span>
                &copy; @DateTime.Now.Year - GoogleBooks 書籍查詢
            </span>
            <span>
                Powered by <a href="https://developers.google.com/books" target="_blank" rel="noopener" noreferrer>
                    Google Books API
                </a>
            </span>
        </div>
    </footer>
    
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": "Google Book 書籍搜尋",
          "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
          "potentialAction": {
            "@@type": "SearchAction",
            "urlTemplate": "@($"{Context.Request.Scheme}://{Context.Request.Host}/{homeController}/{nameof(HomeController.BookSearch)}?q={{search_term_string}}")"
          },
          "query-input": "required name=search_term_string"
        }
    </script>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
