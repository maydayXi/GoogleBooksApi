@using GoogleBookApi.Controllers
@using GoogleBookApi.ViewModels
@using GoogleBookApi.ViewModels.Components

@model IEnumerable<GuidelineItemVm>

@{
    ViewData["Title"] = nameof(HomeController.Guideline);
    PageTitleVm pageTitle = new("使用說明", "如何使用 Google Books 書籍查詢");
}

<section id="guideline" data-screen-description="guideline">
    <partial name="_PageTitle" model="@pageTitle" />
    <div class="d-flex flex-column">
        @foreach (var guideline in Model)
        {
            <div class="guideline-card d-flex align-items-start">
                <div class="card-icon d-flex justify-content-center align-items-center">
                    <i class="@guideline.Icon"></i>
                </div>
                <div class="card-description">
                    <h5>@guideline.Title</h5>
                    <p>
                        @guideline.Description
                    </p>
                </div>
            </div>
        }
    </div>
</section>