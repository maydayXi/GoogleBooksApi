@using ApiService.Enums
@using GoogleBookApi.ViewModels

@model BookSearchVm

@{
    ViewData["Title"] = "書籍搜尋";
    ViewData["Description"] = "輸入 ISBN 或書名，立即搜尋 Google Books 資料庫，查詢書籍基本資料。";
    // 9865026864
}

<section id="book-search" class="pb-2">
    <div class="search-bar">
        <div class="d-flex align-items-center">
            <div class="input-group position-relative">
                <button id="btn-search-by" class="btn dropdown-toggle text-white" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i id="search-by-icon" class="bi bi-upc me-2"></i>
                    <span>ISBN</span>
                </button>
                <ul class="dropdown-menu z-3">
                    @foreach (var dropdownItem in Model.DropdownItems)
                    {
                        <li>
                            <dropdonw-item icon="@dropdownItem.Icon" class="dropdown-item"
                                           style="color: var(--color-text-secondary) !important;"
                                           aria-label="@dropdownItem.DisplayText" search-by="@dropdownItem.Criteria">
                                @dropdownItem.DisplayText
                            </dropdonw-item>
                        </li>
                    }
                </ul>
                <input type="text" id="book-search-criteria" placeholder="請輸入 ISBN-10 或 ISBN-13..." class="border-0">
            </div>
            <div id="page-size-wrap" class="d-flex align-items-center">
                <label for="page-size">
                    每頁筆數
                </label>
                <select name="page-size" id="page-size">
                    @foreach (PageSize pageSize in Enum.GetValues(typeof(PageSize)))
                    {
                        <option value="@((int)pageSize)">@((int)pageSize)</option>
                    }
                </select>
            </div>
        </div>
    </div>
    
    <div id="book-search-result"></div>
</section>


@section Scripts {
    <script src="~/lib/sweetalert2/dist/js/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script type="module" src="~/js/book-search.js" asp-append-version="true"></script>
}