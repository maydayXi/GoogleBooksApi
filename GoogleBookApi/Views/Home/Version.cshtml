@using GoogleBookApi.Controllers
@using GoogleBookApi.ViewModels.Components

@model IEnumerable<VersionItemVm>

@{
    ViewData["Title"] = nameof(HomeController.Version);
    PageTitleVm pageTitle = new("版本", "系統更新紀錄");
}

<section data-screen-description="version" id="version">
    <partial name="_PageTitle" model="@pageTitle"/>
    <div class="version-list position-relative">
        <div class="list-time-line position-absolute"></div>
        @foreach (var versionItem in Model)
        {
            var firstItem = versionItem == Model.First()
                ? "first-item"
                : string.Empty;

            <div class="list-item position-relative">
                <div class="position-absolute rounded-circle z-1 @firstItem"></div>
                <div class="version-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="version-number fw-bold">
                            @versionItem.Version
                        </span>
                        <span class="released-date @firstItem">
                            @versionItem.ReleasedDate
                        </span>
                    </div>
                    <p>
                        @versionItem.Description
                    </p>
                </div>
            </div>
        }

        <a href="https://github.com/maydayXi/GoogleBooksApi" target="_blank"
           class="btn btn-see-more text-white shadow-sm">
            <i class="bi bi-github me-2"></i>GitHub
        </a>
    </div>
</section>
