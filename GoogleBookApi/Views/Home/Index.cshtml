@using GoogleBookApi.Controllers
@{
    ViewData["Title"] = "Home Page";
    ViewData["Description"] = "使用 Google Books API 搜尋書籍 ISBN 及書名，快速取得出版社、作者、描述等詳細資訊"; 
}

@section Preload
{
    <link rel="preload" as="image" href="~/image/banner.svg" type="image/svg+xml"/>
}

<section id="banner">
    <div class="row align-items-center gx-4">
        <div class="col-md-6">
            <h1 class="fw-bold">
                搜詢 Google Books <br/>
                <span>書籍資料庫</span>
            </h1>
            <p>
                查詢書籍 ISBN、作者、出版社等詳細資。支援 ISBN-10、ISBN-13 及書名搜尋，快速取得 Google Books 書籍資訊。
            </p>
            <div class="btn-row d-flex flex-wrap">
                <a href="@Url.ActionLink(nameof(HomeController.Guideline))" class="btn btn-guideline text-white">
                    使用說明
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a href="@Url.ActionLink(nameof(HomeController.BookSearch))" class="btn btn-start">
                    開始搜尋
                </a>
            </div>
            <div class="stats d-flex flex-wrap">
                <div>
                    <div class="fw-bold">ISBN-10 / 13</div>
                    <div class="mt-2">支援格式</div>
                </div>
                <div>
                    <div class="fw-bold">分頁顯示</div>
                    <div class="mt-2">書名搜尋</div>
                </div>
                <div>
                    <div class="fw-bold">JSON 格式</div>
                    <div class="mt-2">REST API</div>
                </div>
            </div>
        </div>
        <div class="banner-img col-md-6 text-center">
            <img src="~/image/banner.svg" class="img-fluid my-0 mx-auto w-100" alt="Banner Image"/>
        </div>
    </div>
</section>